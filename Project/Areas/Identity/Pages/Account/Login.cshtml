@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container min-vh-100 d-flex align-items-center">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

            <div class="alert alert-info mb-4">
                <strong>You need to be logged in to use site features.</strong>

                <p class="mb-1 mt-2">Test users:</p>

                <ul class="mb-2">
                    <li>pilot@test.com</li>
                    <li>caseworker@test.com</li>
                    <li>admin@test.com</li>
                </ul>

                <p class="mb-0">
                    <strong>Password:</strong> Test123!
                </p>
            </div>

            <h1 class="mb-4">@ViewData["Title"]</h1>

            <form id="account" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email"
                           class="form-label">
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password"
                           class="form-label">
                    </label>

                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true" />

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3 form-check">

                    <input class="form-check-input"
                           asp-for="Input.RememberMe" />

                    <label class="form-check-label"
                           asp-for="Input.RememberMe">
                    </label>

                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    Log in
                </button>

            </form>

            <div class="mt-3 d-flex justify-content-between">

                <a asp-page="./ForgotPassword">
                    Forgot your password?
                </a>

                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    Register as a new user
                </a>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
